{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Shadow tokens for MojaUI. Web-canonical with platform extensions for iOS and Android.",
  "shadow": {
    "compact": {
      "xs": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.06), 0px 1px 2px rgba(16, 24, 40, 0.07), 0px 2px 4px rgba(16, 24, 40, 0.03)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 1 },
            "shadowOpacity": 0.1,
            "shadowRadius": 3
          },
          "mojaui.android": { "elevation": 1 }
        }
      },
      "sm": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.05), 0px 1px 3px rgba(16, 24, 40, 0.10), 0px 3px 8px rgba(16, 24, 40, 0.05)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 2 },
            "shadowOpacity": 0.12,
            "shadowRadius": 5
          },
          "mojaui.android": { "elevation": 2 }
        }
      },
      "md": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.04), 0px 2px 4px rgba(16, 24, 40, 0.12), 0px 4px 12px rgba(16, 24, 40, 0.06)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 4 },
            "shadowOpacity": 0.14,
            "shadowRadius": 8
          },
          "mojaui.android": { "elevation": 4 }
        }
      },
      "lg": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.03), 0px 4px 6px rgba(16, 24, 40, 0.14), 0px 8px 24px rgba(16, 24, 40, 0.08)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 6 },
            "shadowOpacity": 0.16,
            "shadowRadius": 12
          },
          "mojaui.android": { "elevation": 6 }
        }
      },
      "xl": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.03), 0px 6px 10px rgba(16, 24, 40, 0.16), 0px 14px 36px rgba(16, 24, 40, 0.10)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 10 },
            "shadowOpacity": 0.18,
            "shadowRadius": 18
          },
          "mojaui.android": { "elevation": 10 }
        }
      }
    },
    "wide": {
      "xs": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.05), 0px 2px 4px rgba(16, 24, 40, 0.08), 0px 4px 10px rgba(16, 24, 40, 0.04)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 3 },
            "shadowOpacity": 0.1,
            "shadowRadius": 6
          },
          "mojaui.android": { "elevation": 2 }
        }
      },
      "sm": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.04), 0px 4px 8px rgba(16, 24, 40, 0.10), 0px 8px 22px rgba(16, 24, 40, 0.06)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 6 },
            "shadowOpacity": 0.12,
            "shadowRadius": 12
          },
          "mojaui.android": { "elevation": 4 }
        }
      },
      "md": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.03), 0px 6px 12px rgba(16, 24, 40, 0.12), 0px 14px 32px rgba(16, 24, 40, 0.07)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 10 },
            "shadowOpacity": 0.14,
            "shadowRadius": 18
          },
          "mojaui.android": { "elevation": 8 }
        }
      },
      "lg": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.03), 0px 8px 16px rgba(16, 24, 40, 0.14), 0px 20px 48px rgba(16, 24, 40, 0.09)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 14 },
            "shadowOpacity": 0.16,
            "shadowRadius": 24
          },
          "mojaui.android": { "elevation": 12 }
        }
      },
      "xl": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(16, 24, 40, 0.02), 0px 12px 22px rgba(16, 24, 40, 0.16), 0px 28px 64px rgba(16, 24, 40, 0.11)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 20 },
            "shadowOpacity": 0.18,
            "shadowRadius": 32
          },
          "mojaui.android": { "elevation": 16 }
        }
      }
    },
    "anchored": {
      "bottom": {
        "$type": "shadow",
        "$value": "0 -1px 0 0 rgba(16, 24, 40, 0.06), 0px -4px 8px rgba(16, 24, 40, 0.14), 0px -10px 24px rgba(16, 24, 40, 0.08)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": -6 },
            "shadowOpacity": 0.16,
            "shadowRadius": 14
          },
          "mojaui.android": { "elevation": 8 }
        }
      },
      "top": {
        "$type": "shadow",
        "$value": "0 1px 0 0 rgba(16, 24, 40, 0.06), 0px 4px 8px rgba(16, 24, 40, 0.14), 0px 10px 24px rgba(16, 24, 40, 0.08)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 6 },
            "shadowOpacity": 0.16,
            "shadowRadius": 14
          },
          "mojaui.android": { "elevation": 8 }
        }
      },
      "left": {
        "$type": "shadow",
        "$value": "1px 0 0 0 rgba(16, 24, 40, 0.06), 4px 0px 8px rgba(16, 24, 40, 0.14), 10px 0px 24px rgba(16, 24, 40, 0.08)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 4, "height": 0 },
            "shadowOpacity": 0.16,
            "shadowRadius": 14
          },
          "mojaui.android": { "elevation": 8 }
        }
      },
      "right": {
        "$type": "shadow",
        "$value": "-1px 0 0 0 rgba(16, 24, 40, 0.06), -4px 0px 8px rgba(16, 24, 40, 0.14), -10px 0px 24px rgba(16, 24, 40, 0.08)",
        "$extensions": {
          "mojaui.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": -4, "height": 0 },
            "shadowOpacity": 0.16,
            "shadowRadius": 14
          },
          "mojaui.android": { "elevation": 8 }
        }
      }
    }
  }
}
