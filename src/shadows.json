        ],
        "$extensions": {
          "platform.ios": {
            "shadowColor": "#101828",
            "shadowOffset": { "width": 0, "height": 1 },
            "shadowOpacity": 0.1,
            "shadowRadius": 3
          },
          "platform.android": { "elevation": 1 }
        }
      },
