{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Typography tokens for MojaUI (heading and body fonts).",
  "typography": {
    "weight": {
      "400": { "$type": "fontWeight", "$value": 400 },
      "500": { "$type": "fontWeight", "$value": 500 },
      "600": { "$type": "fontWeight", "$value": 600 },
      "700": { "$type": "fontWeight", "$value": 700 },
      "800": { "$type": "fontWeight", "$value": 800 }
    },
    "heading": {
      "fontFamily": { "$type": "fontFamily", "$value": "NunitoSans" },
      "fontFamilyWeb": { "$type": "fontFamily", "$value": "NunitoSans, Inter, system-ui, sans-serif" },
      "fontFamilyNative": { "$type": "fontFamily", "$value": "NunitoSans-Regular" },
      "size": {
        "1": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } },
        "2": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
        "3": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
        "4": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "5": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } }
      },
      "fontWeight": {
        "1": { "$type": "fontWeight", "$value": "{typography.weight.800}" },
        "2": { "$type": "fontWeight", "$value": "{typography.weight.700}" },
        "3": { "$type": "fontWeight", "$value": "{typography.weight.700}" },
        "4": { "$type": "fontWeight", "$value": "{typography.weight.600}" },
        "5": { "$type": "fontWeight", "$value": "{typography.weight.600}" }
      },
      "lineHeight": {
        "1": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } },
        "2": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
        "3": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } },
        "4": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
        "5": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } }
      },
      "letterSpacing": {
        "1": { "$type": "number", "$value": -0.02 },
        "2": { "$type": "number", "$value": -0.02 },
        "3": { "$type": "number", "$value": -0.02 },
        "4": { "$type": "number", "$value": 0 },
        "5": { "$type": "number", "$value": 0 }
      },
      "paragraphSpacing": {
        "1": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
        "2": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
        "3": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "4": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "5": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      },
      "$extensions": {
        "platform.fontFace": {
          "400": { "normal": "NunitoSans-Regular" },
          "500": { "normal": "NunitoSans-Medium" },
          "600": { "normal": "NunitoSans-SemiBold" },
          "700": { "normal": "NunitoSans-Bold" },
          "800": { "normal": "NunitoSans-ExtraBold" }
        }
      }
    },
    "body": {
      "fontFamily": { "$type": "fontFamily", "$value": "Inter" },
      "fontFamilyWeb": { "$type": "fontFamily", "$value": "Inter, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif" },
      "fontFamilyNative": { "$type": "fontFamily", "$value": "Inter-Regular" },
      "size": {
        "lg": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "md": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "xxs": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } }
      },
      "fontWeight": {
        "lg": { "$type": "fontWeight", "$value": "{typography.weight.400}" },
        "md": { "$type": "fontWeight", "$value": "{typography.weight.400}" },
        "sm": { "$type": "fontWeight", "$value": "{typography.weight.400}" },
        "xs": { "$type": "fontWeight", "$value": "{typography.weight.400}" },
        "xxs": { "$type": "fontWeight", "$value": "{typography.weight.400}" }
      },
      "lineHeight": {
        "lg": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
        "md": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "sm": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "xs": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "xxs": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
      },
      "letterSpacing": {
        "lg": { "$type": "number", "$value": 0 },
        "md": { "$type": "number", "$value": 0 },
        "sm": { "$type": "number", "$value": 0 },
        "xs": { "$type": "number", "$value": 0.01 },
        "xxs": { "$type": "number", "$value": 0.02 }
      },
      "paragraphSpacing": {
        "lg": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "md": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "sm": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "xxs": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
      },
      "$extensions": {
        "platform.fontFace": {
          "400": { "normal": "Inter-Regular" },
          "500": { "normal": "Inter-Medium" },
          "600": { "normal": "Inter-SemiBold" },
          "700": { "normal": "Inter-Bold" },
          "800": { "normal": "Inter-ExtraBold" }
        }
      }
    }
  }
}
